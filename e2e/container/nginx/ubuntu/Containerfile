# Ubuntu image running nginx with one of two profiles, selected at runtime by
# the entrypoint argument: `hardened` or `weak`.
#
# The profiles are the Ubuntu stock layout (`www-data` worker user,
# `/run/nginx.pid`, the `modules-enabled` include), the Alpine ones use the
# `nginx` user and `/run/nginx/nginx.pid` instead.
#
# The Ubuntu release is pinned to the LTS the QEMU e2e VMs run (noble), so the
# nginx version stays stable for baselines. A self-signed certificate is
# generated at build time so the hardened profile can serve HTTPS behind the
# HTTP to HTTPS redirect checked by NGX_006.
FROM docker.io/ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        nginx \
        openssl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/nginx/ssl \
    && openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
        -subj "/CN=localhost" \
        -keyout /etc/nginx/ssl/e2e.key \
        -out /etc/nginx/ssl/e2e.crt \
    && chmod 600 /etc/nginx/ssl/e2e.key

COPY hardened /profiles/hardened
COPY weak /profiles/weak
COPY entrypoint.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["hardened"]
