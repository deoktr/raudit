      "type_uid": 200301,
      "finding_info": {
        "uid": "GRP_100",
        "title": "Ensure `/etc/group` file owner is `root:root`",
        "desc": "If `/etc/group` is owned by a non-root user, that user can edit group membership and silently grant themselves any group's privileges, including `wheel`, `sudo`, or `docker`, each of which leads to root."
      },
      "compliance": {
        "standards": [
          "CIS Benchmark"
        ],
        "status_id": 1,
        "status": "Pass"
      },
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "`chown root:root /etc/group`"
      },
      "severity_id": 4,
      "severity": "High",
      "status_id": 4,
      "status": "Resolved"
    },
    {
      "activity_id": 1,
      "activity_name": "Create",
      "category_uid": 2,
      "category_name": "Findings",
      "class_uid": 2003,
      "class_name": "Compliance Finding",
      "type_uid": 200301,
      "finding_info": {
        "uid": "GRP_101",
        "title": "Ensure `/etc/group` file permissions are `644`",
        "desc": "Permissions wider than 0644 let unprivileged users modify group membership. Tighter than 0644 breaks userland tools that expect to read group names. 0644 is the only safe value."
      },
      "compliance": {
        "standards": [
          "CIS Benchmark"
        ],
        "status_id": 1,
        "status": "Pass"
      },
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "`chmod 644 /etc/group`"
      },
      "severity_id": 4,
      "severity": "High",
      "status_id": 4,
      "status": "Resolved"
    },
