      "type_uid": 200301,
      "finding_info": {
        "uid": "GRP_001",
        "title": "Ensure `/etc/gshadow` has no usable group password",
        "desc": "A group password stored in /etc/gshadow lets any holder switch into the group via `newgrp`, expanding lateral movement. Every entry must have its password field locked (`!`/`*`, what `gpasswd -r` produces) or empty, the file may also be absent, so this attack vector does not exist."
      },
      "compliance": {
        "standards": [
          "raudit"
        ],
        "status_id": 1,
        "status": "Pass"
      },
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "Lock every group password via `gpasswd -r <group>`, or remove `/etc/gshadow`."
      },
      "severity_id": 4,
      "severity": "High",
      "status_id": 4,
      "status": "Resolved"
    },
    {
      "activity_id": 1,
      "activity_name": "Create",
      "category_uid": 2,
      "category_name": "Findings",
      "class_uid": 2003,
      "class_name": "Compliance Finding",
      "type_uid": 200301,
      "finding_info": {
        "uid": "GRP_002",
        "title": "Ensure no group has a password set",
        "desc": "A password in /etc/group lets any user with that password assume the group's privileges via `newgrp`, bypassing the membership list, turning the group hash into a shared lateral-movement credential as soon as it leaks."
      },
      "compliance": {
        "standards": [
          "raudit"
        ],
        "status_id": 1,
        "status": "Pass"
      },
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "Remove passwords from groups via `gpasswd -r <group>`."
      },
      "severity_id": 4,
      "severity": "High",
      "status_id": 4,
      "status": "Resolved"
    },
    {
      "activity_id": 1,
      "activity_name": "Create",
      "category_uid": 2,
      "category_name": "Findings",
      "class_uid": 2003,
      "class_name": "Compliance Finding",
      "type_uid": 200301,
      "finding_info": {
        "uid": "GRP_003",
        "title": "Ensure that only root has GID 0",
        "desc": "A second group with GID 0 is privilege-equivalent to `root` for filesystem and IPC ACLs. An attacker who creates one or who pivots into membership gains root-level group access without ever being root."
      },
      "compliance": {
        "standards": [
          "raudit"
        ],
        "status_id": 1,
        "status": "Pass"
      },
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "Remove or renumber any non-`root` group with GID 0 via `groupmod -g <new-gid> <name>`, investigate how it was created."
      },
      "severity_id": 4,
      "severity": "High",
      "status_id": 4,
      "status": "Resolved"
    },
    {
      "activity_id": 1,
      "activity_name": "Create",
