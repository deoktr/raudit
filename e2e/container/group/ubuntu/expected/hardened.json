      "type_uid": 200301,
      "finding_info": {
        "uid": "GRP_006",
        "title": "Ensure `shadow` group is empty",
        "desc": "Members of the `shadow` group can read `/etc/shadow` and crack account's password hash. Membership should be empty so no non-root account holds that capability."
      },
      "compliance": {
        "standards": [
          "CIS Benchmark",
          "DISA STIG"
        ],
        "status_id": 1,
        "status": "Pass"
      },
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "Remove all members from the `shadow` group via `gpasswd -d <user> shadow`."
      },
      "severity_id": 3,
      "severity": "Medium",
      "status_id": 4,
      "status": "Resolved"
    },
    {
