      "finding_info": {
        "uid": "GRP_102",
        "title": "Ensure `/etc/gshadow` file owner is `root:root` or file is missing",
        "desc": "Wrong ownershoip of `/etc/gshadow` leaks group password hashes (when present) for offline cracking and exposes sensitive group elevation policy."
      },
      "compliance": {
        "standards": [
          "CIS Benchmark"
        ],
        "status_id": 1,
        "status": "Pass"
      },
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "On Debian: `chown root:shadow /etc/gshadow`\nOn other distros: `chown root:root /etc/gshadow`."
      },
      "severity_id": 3,
      "severity": "Medium",
      "status_id": 4,
      "status": "Resolved"
    },
