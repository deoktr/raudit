        "title": "Ensure `/etc/gshadow` file permissions are set or file is missing",
        "desc": "World- or group-readable `/etc/gshadow` leaks group password hashes (when present) for offline cracking and exposes sensitive group elevation policy."
      },
      "compliance": {
        "standards": [
          "CIS Benchmark"
        ],
        "status_id": 1,
        "status": "Pass"
