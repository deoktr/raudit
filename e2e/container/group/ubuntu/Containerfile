# Ubuntu image with a group database for one of two profiles, selected at
# runtime by the entrypoint argument: `hardened` or `weak`.
#
# /etc/group and /etc/gshadow are static files shipped per profile so results
# never depend on runtime state. Both databases reproduce the stock Ubuntu
# layout: `nogroup` at 65534, the `shadow` group at 42, and a *populated*
# gshadow whose password fields are all locked (`!`/`*`), which is what
# GRP_001 must accept (Alpine ships no gshadow at all and covers the
# missing-file path instead, see e2e/findings.md).
#
# The weak profile sabotages the group database content (a group password,
# duplicate GIDs and names, a member of the `shadow` group) and the ownership
# and permissions of /etc/group, /etc/gshadow and /etc/gshadow-, which are
# `root:shadow 0640` on the Debian family (GRP_102..GRP_105).
#
# GRP_006 (the `shadow` group) only runs here, it is skipped on Alpine. The
# `/etc/passwd` and `/etc/shadow` file checks (USR_100..USR_107) live in the
# user container, they used to be mistagged `group`, see e2e/findings.md.
FROM docker.io/ubuntu:24.04

COPY hardened /profiles/hardened
COPY weak /profiles/weak
COPY entrypoint.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["hardened"]
