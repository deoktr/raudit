      "finding_info": {
        "uid": "SUD_200",
        "title": "Ensure sudoers config file permissions are 440 or stricter",
        "desc": "Sudo will intentionally not use configurations that are world-writable or -readable, otherwise this could lead to privilege escalation. A stricter mode (0400 for example) is accepted, sudo reads the file as root."
      },
      "compliance": {
        "standards": [
          "raudit"
        ],
        "status_id": 3,
        "status": "Fail"
      },
      "message": "wanted `440` or stricter got `644`",
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "chmod 440 /etc/sudoers"
      },
      "severity_id": 4,
      "severity": "High",
      "status_id": 1,
      "status": "New"
    },
