        "title": "Ensure that sudo default config `ignore_dot` is set",
        "desc": "Skip `.` when searching PATH for the target binary. Without it, an attacker who drops a malicious binary into a sudo'd user's CWD can have it executed as root simply because PATH started with `.`."
      },
      "compliance": {
        "standards": [
          "raudit"
        ],
        "status_id": 3,
        "status": "Fail"
      },
      "message": "`Defaults ignore_dot` is not present",
