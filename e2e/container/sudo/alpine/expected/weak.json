        "title": "Ensure that sudo default config `env_reset` is set",
        "desc": "Start the command with a minimal, sanitized environment (only variables on env_keep survive), blocks LD_PRELOAD-style attacks. Breaks scripts and applications that depend on user environment variables (e.g. PATH customizations, application-specific env vars) unless explicitly added to env_keep."
      },
      "compliance": {
        "standards": [
          "raudit"
        ],
        "status_id": 3,
        "status": "Fail"
      },
      "message": "`Defaults env_reset` is not present",
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "In `/etc/sudoers` or `/etc/sudoers.d/*` add: `Defaults env_reset`"
      },
      "severity_id": 4,
      "severity": "High",
      "status_id": 1,
      "status": "New"
