    {
      "activity_id": 1,
      "activity_name": "Create",
      "category_uid": 2,
      "category_name": "Findings",
      "class_uid": 2003,
      "class_name": "Compliance Finding",
      "type_uid": 200301,
      "finding_info": {
        "uid": "SUD_015",
        "title": "Ensure that sudoers config does not contain `NOPASSWD`",
        "desc": "`NOPASSWD` lets a sudo-able account escalate to root with no password prompt at all. An attacker who steals only the user's session token (no password) immediately becomes root. Defeats the whole point of sudo's auth gate."
      },
      "compliance": {
        "standards": [
          "CIS Benchmark"
        ],
        "status_id": 3,
        "status": "Fail"
      },
      "message": "root ALL=(ALL) NOPASSWD: ALL",
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "In `/etc/sudoers` and `/etc/sudoers.d/*` remove all instances with `NOPASSWD`"
      },
      "severity_id": 5,
      "severity": "Critical",
      "status_id": 1,
      "status": "New"
    },
    {
      "activity_id": 1,
      "activity_name": "Create",
      "category_uid": 2,
      "category_name": "Findings",
      "class_uid": 2003,
      "class_name": "Compliance Finding",
      "type_uid": 200301,
      "finding_info": {
        "uid": "SUD_016",
        "title": "Ensure that sudoers re authentication is not disabled",
        "desc": "`Defaults !authenticate` (globally or scoped like `Defaults:user !authenticate`) disables the password prompt entirely for matching rules, the same effect as `NOPASSWD`, often missed by NOPASSWD-only audits. Classic sudo only accepts it as a `Defaults` flag, not as a rule tag. Removes the auth gate that protects every sudo invocation."
      },
      "compliance": {
        "standards": [
          "raudit"
        ],
        "status_id": 3,
        "status": "Fail"
      },
      "message": "Defaults !authenticate",
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "In `/etc/sudoers` and `/etc/sudoers.d/*` remove all instances with `!authenticate`"
      },
      "severity_id": 5,
      "severity": "Critical",
      "status_id": 1,
      "status": "New"
    },
