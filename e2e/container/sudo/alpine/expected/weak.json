        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "In `/etc/sudoers` or `/etc/sudoers.d/*` add: `Defaults ignore_dot`"
      },
      "severity_id": 4,
      "severity": "High",
      "status_id": 1,
      "status": "New"
    },
