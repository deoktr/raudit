      "type_uid": 200301,
      "finding_info": {
        "uid": "SUD_012",
        "title": "Ensure that sudo default config `secure_path` is set",
        "desc": "Without `secure_path` sudo inherits the caller's PATH, a user-writable directory earlier in it substitutes the command the rule meant to grant. `ignore_dot` only neutralises the `.` entry, not a planted `/home/foo/bin/systemctl`."
      },
      "compliance": {
        "standards": [
          "CIS Benchmark"
        ],
        "status_id": 3,
        "status": "Fail"
      },
      "message": "`Defaults secure_path` is not present",
      "metadata": {
        "version": "1.7.0",
        "product": {
          "name": "raudit",
          "version": ""
        }
      },
      "remediation": {
        "desc": "In `/etc/sudoers` or `/etc/sudoers.d/*` add: `Defaults secure_path=\\\"/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin\\\"`"
      },
      "severity_id": 4,
      "severity": "High",
      "status_id": 1,
      "status": "New"
    },
