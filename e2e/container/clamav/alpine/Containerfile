# Alpine image running ClamAV with one of two profiles, selected at runtime
# by the entrypoint argument: `hardened` (installed, clamd running) or `weak`
# (not installed at all, CAV_001 only probes `clamscan` in PATH).
#
# The Alpine release is pinned so the ClamAV version stays stable for
# baselines.
FROM docker.io/alpine:3.22

RUN apk add --no-cache clamav

COPY entrypoint.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["hardened"]
