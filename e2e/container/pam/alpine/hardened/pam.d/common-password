#%PAM-1.0
# quality and reuse checks must run before pam_unix writes the new hash
password requisite pam_pwquality.so retry=3 minlen=14 difok=3
password required pam_pwhistory.so remember=5 use_authtok
password [success=1 default=ignore] pam_unix.so obscure use_authtok yescrypt
password requisite pam_deny.so
