# rAudit e2e hardened login.defs (excerpt), feeds LDF_002 (tagged `pam`)
MAIL_DIR		/var/spool/mail
FAILLOG_ENAB		yes
LOG_UNKFAIL_ENAB	no
LOG_OK_LOGINS		yes
SYSLOG_SU_ENAB		yes
SYSLOG_SG_ENAB		yes
LOGIN_RETRIES		3
LOGIN_TIMEOUT		60
ENCRYPT_METHOD		YESCRYPT
YESCRYPT_COST_FACTOR	8
UMASK			077
PASS_MAX_DAYS		128
PASS_MIN_DAYS		1
PASS_WARN_AGE		7
UID_MIN			1000
GID_MIN			1000
