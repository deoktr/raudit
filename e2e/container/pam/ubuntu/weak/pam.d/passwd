#%PAM-1.0
# rAudit e2e weak passwd service: no account stack at all, a quality check
# under the bar, a two password history and a SHA-crypt hash
# (PAM_001, PAM_002, PAM_003, PAM_005)
password requisite pam_pwquality.so retry=3 minlen=6
password required pam_pwhistory.so remember=2 use_authtok
password [success=1 default=ignore] pam_unix.so obscure use_authtok sha512
